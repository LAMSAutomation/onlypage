# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (browser-safe, exposed to client bundle via VITE_ prefix)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# Supabase (server-only secret - used by server.ts, do NOT prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Optional one-time demo seed credentials. Never commit real passwords.
# PRIME_STRIKES_EMAIL="prime.strikes.demo@example.com"
# PRIME_STRIKES_PASSWORD="use-a-unique-12-plus-character-password"

# Payments (server-only; never use a VITE_ prefix and never save these in the browser)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="replace_with_server_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_webhook_secret"

# Evolution API WhatsApp automation (server-only; use an instance-scoped token
# for production, never a VITE_ variable). Set ENABLED only when the instance
# is connected and you intentionally want follow-up sends to go out.
EVOLUTION_API_URL="https://whatsapp-api.example.com"
EVOLUTION_API_KEY="instance_scoped_token"
EVOLUTION_INSTANCE_NAME="onlypage-business"
EVOLUTION_AUTOMATION_ENABLED="false"
# Enable automatic first replies only after you have checked the manual flow.
# Call POST /api/whatsapp/run-automation from a scheduler every 5 minutes with
# this secret in the x-automation-secret header.
EVOLUTION_AUTOMATION_AUTO_FOLLOW_UP="false"
EVOLUTION_AUTOMATION_SECRET="generate_a_long_random_scheduler_secret"
